{
  "name": "defectivecode/faker-storage",
  "description": "A high-performance PHP package for generating and storing large volumes of fake data files.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "DefectiveCode\\Faker\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DefectiveCode\\Faker\\Tests\\": "tests"
    }
  },
  "authors": [
    {
      "name": "Corey McCormick",
      "email": "corey@defectivecode.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-gd": "*",
    "league/flysystem": "^3.36",
    "ramsey/uuid": "^4.10",
    "fakerphp/faker": "^1.24.1",
    "symfony/mime": "^8.1.12",
    "egulias/email-validator": "^4.0.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4.8",
    "laravel/pint": "^1.32.3",
    "phpstan/phpstan": "^2.3.7",
    "symfony/var-dumper": "^8.1.12",
    "swoole/ide-helper": "^6.2.5"
  },
  "conflict": {
    "league/flysystem-local": "<3.25.1",
    "league/mime-type-detection": "<1.16"
  },
  "suggest": {
    "ext-swoole": "Required for Swoole worker support for parallel file generation",
    "ext-pcntl": "Required for PCNTL worker support for parallel file generation"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "lint": "vendor/bin/pint",
    "analyse": "vendor/bin/phpstan analyse"
  }
}
